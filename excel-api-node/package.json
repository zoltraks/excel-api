{
  "name": "excel-api-node",
  "version": "0.0.6",
  "description": "Excel API — Node.js/TypeScript implementation",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "bcrypt": "^5.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^11.1.1",
    "yaml": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "overrides": {
    "uuid": "^11.1.1",
    "tar": "^7.4.3"
  }
}
